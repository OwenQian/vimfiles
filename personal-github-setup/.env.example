# Optional defaults — change only if your setup differs.
# Every repository in this directory gets the personal signing settings.
ONEPASSWORD_SSH_SIGN_PROGRAM=/Applications/1Password.app/Contents/MacOS/op-ssh-sign
PERSONAL_GITHUB_HOST=github-personal.com

# REQUIRED
# Public-key file for the personal 1Password SSH key. Its public value must
# also be registered in GitHub as both an authentication and signing key.
PERSONAL_SSH_PUBLIC_KEY_PATH=~/.ssh/id_personal.pub
PERSONAL_REPOS_DIR=~/Projects/personal
